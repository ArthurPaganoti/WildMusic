# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=spotify
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=0

# Mail Configuration
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS_ENABLE=false
MAIL_STARTTLS_REQUIRED=false
MAIL_SSL_ENABLE=false

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION=3600

# System Configuration
SYSTEM_SECRET=your_system_secret_here

# App Configuration
APP_EMAIL_FROM=your_email@example.com
APP_EMAIL_FROM_NAME=Spotify
APP_PASSWORD_RESET_EXPIRATION_HOURS=24
APP_FRONTEND_URL=http://localhost:3000

# Server Configuration
SERVER_PORT=8080

# ImageKit Configuration
IMAGEKIT_URL_ENDPOINT=your_imagekit_url_endpoint
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key

# YouTube API Configuration
YOUTUBE_API_KEY=your_youtube_api_key

# Logging Configuration
SHOW_SQL=false
LOG_LEVEL_ROOT=info
LOG_LEVEL_HIBERNATE=debug
LOG_LEVEL_SPRING=info

